{
  "name": "james-honeybadger-pages",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Static GitHub Pages site: pinned highlights and a repository directory.",
  "scripts": {
    "data": "node scripts/update-pinned.mjs && node scripts/update-repos.mjs",
    "check": "node scripts/validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.6.2"
  }
}
